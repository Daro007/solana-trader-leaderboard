# Leave HELIUS_API_KEY empty to run fully offline with deterministic mock data.
# Free key: https://dashboard.helius.dev
HELIUS_API_KEY=

# Force mock mode even if a key is set (CI does this).
# DATA_MODE=mock

# Optional: comma-separated pool addresses to watch (defaults: Raydium + Orca SOL-USDC).
# SOLANA_POOL_ADDRESSES=58oQChx4yWmvKdwLLZzBi4ChoCc2fqCUWBkwMihLYQo2,Czfq3xZZDmsdGdUyrNLtRhGc47cXcZtLG4crryfu44zE

# Optional: Helius API base URL.
# HELIUS_API_BASE=https://api.helius.xyz
